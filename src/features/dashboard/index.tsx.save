          </div>

          <div className="flex h-14 w-14 items-center justify-center rounded-2xl border border-cyan-300/20 bg-cyan-400/10 text-cyan-300">
            <RiWallet3Line className="text-2xl" />
          </div>
        </div>

        <div className="mt-8 flex flex-wrap gap-3">
          {hasWallet ? (
