import {
  RiAddLine,
  RiArrowDownLine,
  RiArrowUpLine,
  RiGlobalLine,
  RiShieldCheckLine,
  RiWallet3Line,
} from "react-icons/ri";
import { Link } from "react-router-dom";
import { useWalletStore } from "../../stores/wallet-store";

export default function Dashboard() {
